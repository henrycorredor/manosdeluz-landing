---
import PortadaElegua from "../../assets/hero/portada-elegua-1920x1080-px.webp"
import PortadaFortuna from "../../assets/hero/portada-Fortuna-&-Casino-1920x1080-px.webp"
import PortadaLimpia from "../../assets/hero/portada-limpia-y-despojo-1920x1080-px.webp"
import PortadaOshun from "../../assets/hero/portada-Oshun-1920x1080-px.webp"
import PortadaRuda from "../../assets/hero/portada-Ruda-1920x1080-px.webp"
import PortadaYemeya from "../../assets/hero/portada-Yemeya-1920x1080-px.webp"
import VertElegua from "../../assets/hero/vertical/portada-elegua-1080x1920-px.webp"
import VertFortuna from "../../assets/hero/vertical/portada-Fortuna-&-Casino-1080x1920-px.webp"
import VertLimpia from "../../assets/hero/vertical/portada-Limpia-y-despojo-1080x1920-px.webp"
import VertOshun from "../../assets/hero/vertical/portada-oshun-1080x1920-px.webp"
import VertRuda from "../../assets/hero/vertical/portada-Ruda-1080x1920-px.webp"
import VertYemeya from "../../assets/hero/vertical/portada-Yemaya-1080x1920-px.webp"

const slides = [
  { desktop: PortadaElegua, mobile: VertElegua },
  { desktop: PortadaFortuna, mobile: VertFortuna },
  { desktop: PortadaLimpia, mobile: VertLimpia },
  { desktop: PortadaOshun, mobile: VertOshun },
  { desktop: PortadaRuda, mobile: VertRuda },
  { desktop: PortadaYemeya, mobile: VertYemeya },
]
---

<section>
  <h1 class="sr-only">Manos de Luz - Productos para botánicas en Estados Unidos</h1>
  <main class="hero-main">
    <div class="hero-carousel">
      {slides.map((slide) => (
        <div class="hero-slide">
          <picture>
            <source media="(max-width: 800px)" srcset={slide.mobile.src} />
            <img src={slide.desktop.src} alt="" />
          </picture>
        </div>
      ))}
    </div>
    <div class="hero-dots">
      {slides.map((_, index) => (
        <button class="hero-dot" type="button" aria-label={`Ir al slide ${index + 1}`}></button>
      ))}
    </div>
  </main>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".hero-slide")
  const dots = document.querySelectorAll<HTMLElement>(".hero-dot")
  let current = 0
  let timer: ReturnType<typeof setInterval>
  const INTERVAL = 5000

  function show(index: number) {
    slides[current]?.classList.remove("active")
    dots[current]?.classList.remove("active")
    current = index % slides.length
    slides[current]?.classList.add("active")
    dots[current]?.classList.add("active")
  }

  function play() {
    clearInterval(timer)
    timer = setInterval(() => show(current + 1), INTERVAL)
  }

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      show(index)
      play()
    })
  })

  show(0)
  play()
</script>

<style lang="less">
  .hero-main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 98vh;
    overflow: hidden;
  }

  .hero-carousel {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
    &.active {
      opacity: 1;
    }
    picture,
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
  }

  .hero-dots {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: .6rem;
  }

  .hero-dot {
    width: .8rem;
    height: .8rem;
    border-radius: 50%;
    border: 2px solid white;
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: background-color .3s ease;
    &.active {
      background: white;
    }
  }
</style>
